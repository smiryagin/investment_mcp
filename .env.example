# Option A: one full SQL Server connection string.
# SQLSERVER_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=Investments;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;

# Option B: build the connection string from parts.
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_SERVER=localhost
SQLSERVER_DATABASE=Investments
SQLSERVER_TRUSTED_CONNECTION=yes
# SQLSERVER_USER=mcp_readonly
# SQLSERVER_PASSWORD=replace-me
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes

# Stored procedure that returns your research/ranking snapshot.
MCP_RESEARCH_PROCEDURE=dbo.TradeGetDaysChangeReturn

# Set true only if you create sql/create_mcp_research_sp.sql or another
# compatible wrapper proc with @Symbol, @AssetType, @WatchedOnly, @TradedOnly, @Top.
MCP_RESEARCH_PROCEDURE_HAS_FILTERS=false

# Safety limits.
MCP_SQL_TIMEOUT_SECONDS=30
MCP_MAX_ROWS=2500
MCP_TRANSPORT=stdio
